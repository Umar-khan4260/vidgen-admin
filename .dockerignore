# Dependencies and build output (recreated inside the image)
node_modules
.next
out
build
coverage

# Never bake secrets or local env files into the image.
# Pass them at runtime via docker compose env_file / your platform's env vars.
.env
.env.*
*.pem
*.key

# Local tooling / VCS
.git
.gitignore
.vercel
.vscode
.idea
.kilo

# TypeScript and debug artifacts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker files themselves are not needed inside the build context copy
Dockerfile
.dockerignore
docker-compose.yml

# Helper / smoke-test scripts (not needed at runtime)
make-env-docker.js
smoke-test.ps1

# Docs / agent instructions
README.md
AGENTS.md
